# Bearer token the upload agent presents. Generate with:  openssl rand -hex 32
# If this is unset, every write route returns 401. There is no open fallback.
MEDIA_UPLOAD_TOKEN=

# Vercel Blob store token. Created for you when you add a Blob store in the
# Vercel dashboard (Storage -> Create -> Blob). Required in production.
BLOB_READ_WRITE_TOKEN=

# Optional. Base URL returned in the "url" field of API responses.
# Set to https://hemitech.co.ke/media only if you also add the /media rewrite
# documented in README. Leave empty to return the Blob store's own public URL,
# which is the simpler and more reliable option.
MEDIA_PUBLIC_BASE=

# Storage backend: "blob" (default in production) or "fs" (local development).
MEDIA_STORAGE=

# Secret Vercel Cron presents when it calls /api/media/sweep. Vercel sets this
# header itself once the variable exists; the sweep accepts it in place of
# MEDIA_UPLOAD_TOKEN because a cron job cannot present the upload token.
CRON_SECRET=

# ---------------------------------------------------------------- forms ----

# Where new contact and audit submissions are announced.
# "resend" | "webhook" | leave empty for no notification.
# If this is unset the submission is still STORED and the visitor still sees
# success — a submission is never silently lost, only quiet.
NOTIFY_PROVIDER=

# Address that receives the alert, and the verified sender, when using resend.
NOTIFY_TO=
NOTIFY_FROM=
RESEND_API_KEY=

# Endpoint that receives the alert when NOTIFY_PROVIDER=webhook.
NOTIFY_WEBHOOK=

# 32 bytes, base64 or hex. Generate with: openssl rand -base64 32
# Submissions are encrypted with AES-256-GCM before they are written. Set this
# in production: Blob storage has no private access tier, and these records are
# people's names, addresses and messages.
SUBMISSIONS_KEY=

# Storage backend for submissions: "blob" (default in production) or "fs".
SUBMISSIONS_STORAGE=
