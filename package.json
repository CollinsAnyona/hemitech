{
  "name": "hemitech-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HemiTech marketing site, the media hosting API that Buffer fetches from, and the generator that assembles the static pages.",
  "scripts": {
    "build": "node scripts/build-site.js",
    "check": "node scripts/build-site.js --check",
    "shots": "node scripts/capture-shots.js",
